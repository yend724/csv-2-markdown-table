# Do not execute lifecycle scripts from dependencies during installation.
ignore-scripts=true
# Reject unsupported Node.js / npm versions.
engine-strict=true
# Pin versions when adding dependencies; use npm ci for reproducible installs.
save-exact=true
# Keep registry traffic encrypted and certificate verification enabled.
registry=https://registry.npmjs.org/
strict-ssl=true
# Report known vulnerabilities during dependency installation.
audit=true
